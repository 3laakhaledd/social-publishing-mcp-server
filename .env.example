# == Meta (Facebook + Instagram) ==
# Get a Page Access Token with these permissions:
#   Publishing: pages_manage_posts, pages_read_engagement,
#               instagram_basic, instagram_content_publish
#   Conversations: pages_messaging, instagram_manage_messages
META_PAGE_ACCESS_TOKEN=your_page_access_token
META_PAGE_ID=your_facebook_page_id
META_IG_USER_ID=your_instagram_business_account_id
META_API_VERSION=v21.0

# == TikTok ==
# Register app at developers.tiktok.com, add Content Posting API,
# request video.publish + video.upload scopes, pass audit for public posting
TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token

# == Server ==
PORT=8000
